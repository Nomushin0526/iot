# このファイルを .env にコピーして値を入れる (.env は Git に入れない)
#   cp .env.example .env

# --- 内容判定 (どれも無ければ Ollama → キーワード判定の順に自動で切り替わる)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CONTENT_BACKEND=auto           # auto / anthropic / openai / ollama / keyword
# OLLAMA_MODEL=gemma3:4b         # 空なら入っている Gemma を自動選択
# MASK_NAMES=山田,太郎            # 外部に送る前に必ず伏せる名前 (カンマ区切り)

# --- 文字起こし
WHISPER_MODEL=small              # tiny / base / small (大きいほど正確で遅い)
# WHISPER_LANGUAGE=ja            # 空なら自動判定 (国際電話の英語・中国語にも対応)

# --- Slack 通知
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
NOTIFY_THRESHOLD=7               # 危険度がこれ以上で自動通知
# SLACK_SHOW_NUMBER=0            # 1 で番号を伏せずに送る

# --- サーバー
PORT=8000
# CHECK_TOKEN=好きな文字列         # 設定するとショートカットからも同じ値の送信が必要
USE_HARDWARE=1                   # 0 で GPIO を使わない (PC での動作確認用)
KEEP_AUDIO=0                     # 1 で判定後も音声を data/uploads に残す
